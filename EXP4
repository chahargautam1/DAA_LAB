
#include <stdio.h>
#include <stdlib.h>

struct Node {
    char ch;
    int freq;
    struct Node *left, *right;
};

struct Node* createNode(char ch, int freq) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));

    if (node == NULL) {
        printf("Memory allocation failed!\n");
        exit(1);
    }

    node->ch = ch;
    node->freq = freq;
    node->left = NULL;
    node->right = NULL;

    return node;
}

void sortNodes(struct Node* nodes[], int n) {
    int i, j;
    struct Node* temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (nodes[j]->freq > nodes[j + 1]->freq) {
                temp = nodes[j];
                nodes[j] = nodes[j + 1];
                nodes[j + 1] = temp;
            }
        }
    }
}

void printCodes(struct Node* root, int code[], int top) {
    int i;

    if (root->left != NULL) {
        code[top] = 0;
        printCodes(root->left, code, top + 1);
    }

    if (root->right != NULL) {
        code[top] = 1;
        printCodes(root->right, code, top + 1);
    }

    if (root->left == NULL && root->right == NULL) {
        printf("%c : ", root->ch);

        if (top == 0)
            printf("0");

        for (i = 0; i < top; i++)
            printf("%d", code[i]);

        printf("\n");
    }
}

void freeTree(struct Node* root) {
    if (root == NULL)
        return;

    freeTree(root->left);
    freeTree(root->right);
    free(root);
}

int main() {
    struct Node* nodes[100];
    int n, i, code[100];

    printf("Enter number of characters (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) {
        printf("Invalid number of characters!\n");
        return 1;
    }

    printf("Enter character and frequency:\n");

    for (i = 0; i < n; i++) {
        char ch;
        int freq;

        if (scanf(" %c %d", &ch, &freq) != 2 || freq <= 0) {
            printf("Invalid input or frequency!\n");
            return 1;
        }

        nodes[i] = createNode(ch, freq);
    }

    while (n > 1) {
        sortNodes(nodes, n);

        struct Node* left = nodes[0];
        struct Node* right = nodes[1];

        struct Node* parent =
            createNode('$', left->freq + right->freq);

        parent->left = left;
        parent->right = right;

        for (i = 2; i < n; i++)
            nodes[i - 2] = nodes[i];

        nodes[n - 2] = parent;
        n--;
    }

    printf("\nHuffman Codes:\n");
    printCodes(nodes[0], code, 0);

    freeTree(nodes[0]);

    return 0;
}
