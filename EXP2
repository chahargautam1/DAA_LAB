
#include <stdio.h>

int main() {
    int a[100], n, i, choice, key;
    int low, high, mid, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid array size!\n");
        return 1;
    }

    printf("Enter elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("\n1. Linear Search");
    printf("\n2. Binary Search");
    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    printf("Enter element to search: ");
    scanf("%d", &key);

    switch (choice) {
        case 1:
            for (i = 0; i < n; i++) {
                if (a[i] == key) {
                    printf("Element found at position %d\n", i + 1);
                    found = 1;
                    break;
                }
            }

            if (!found)
                printf("Element not found\n");
            break;

        case 2:
            /* Binary Search requires sorted elements */
            for (i = 0; i < n - 1; i++) {
                if (a[i] > a[i + 1]) {
                    printf("Error: Binary Search requires sorted elements!\n");
                    return 1;
                }
            }

            low = 0;
            high = n - 1;

            while (low <= high) {
                mid = low + (high - low) / 2;

                if (a[mid] == key) {
                    printf("Element found at position %d\n", mid + 1);
                    found = 1;
                    break;
                } else if (a[mid] < key) {
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            if (!found)
                printf("Element not found\n");
            break;

        default:
            printf("Invalid choice!\n");
    }

    return 0;
}
