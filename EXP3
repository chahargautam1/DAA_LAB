
#include <stdio.h>

#define MAX 64

void add(int n, int A[MAX][MAX], int B[MAX][MAX],
         int R[MAX][MAX]) {
    int i, j;
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            R[i][j] = A[i][j] + B[i][j];
}

void sub(int n, int A[MAX][MAX], int B[MAX][MAX],
         int R[MAX][MAX]) {
    int i, j;
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            R[i][j] = A[i][j] - B[i][j];
}

void multiply(int n, int A[MAX][MAX], int B[MAX][MAX],
              int C[MAX][MAX]) {
    int i, j, k;

    if (n == 1) {
        C[0][0] = A[0][0] * B[0][0];
        return;
    }

    int m = n / 2;
    int A11[MAX][MAX], A12[MAX][MAX];
    int A21[MAX][MAX], A22[MAX][MAX];
    int B11[MAX][MAX], B12[MAX][MAX];
    int B21[MAX][MAX], B22[MAX][MAX];
    int M1[MAX][MAX], M2[MAX][MAX], M3[MAX][MAX];
    int M4[MAX][MAX], M5[MAX][MAX], M6[MAX][MAX], M7[MAX][MAX];
    int T1[MAX][MAX], T2[MAX][MAX];
    int X[MAX][MAX], Y[MAX][MAX], Z[MAX][MAX], W[MAX][MAX];

    for (i = 0; i < m; i++) {
        for (j = 0; j < m; j++) {
            A11[i][j] = A[i][j];
            A12[i][j] = A[i][j + m];
            A21[i][j] = A[i + m][j];
            A22[i][j] = A[i + m][j + m];

            B11[i][j] = B[i][j];
            B12[i][j] = B[i][j + m];
            B21[i][j] = B[i + m][j];
            B22[i][j] = B[i + m][j + m];
        }
    }

    // M1 = (A11 + A22)(B11 + B22)
    add(m, A11, A22, T1);
    add(m, B11, B22, T2);
    multiply(m, T1, T2, M1);

    // M2 = (A21 + A22)B11
    add(m, A21, A22, T1);
    multiply(m, T1, B11, M2);

    // M3 = A11(B12 - B22)
    sub(m, B12, B22, T1);
    multiply(m, A11, T1, M3);

    // M4 = A22(B21 - B11)
    sub(m, B21, B11, T1);
    multiply(m, A22, T1, M4);

    // M5 = (A11 + A12)B22
    add(m, A11, A12, T1);
    multiply(m, T1, B22, M5);

    // M6 = (A21 - A11)(B11 + B12)
    sub(m, A21, A11, T1);
    add(m, B11, B12, T2);
    multiply(m, T1, T2, M6);

    // M7 = (A12 - A22)(B21 + B22)
    sub(m, A12, A22, T1);
    add(m, B21, B22, T2);
    multiply(m, T1, T2, M7);

    // C11 = M1 + M4 - M5 + M7
    add(m, M1, M4, X);
    sub(m, X, M5, Y);
    add(m, Y, M7, Z);

    // C12 = M3 + M5
    add(m, M3, M5, W);

    for (i = 0; i < m; i++)
        for (j = 0; j < m; j++) {
            C[i][j] = Z[i][j];
            C[i][j + m] = W[i][j];
        }

    // C21 = M2 + M4
    add(m, M2, M4, X);

    // C22 = M1 - M2 + M3 + M6
    sub(m, M1, M2, Y);
    add(m, Y, M3, Z);
    add(m, Z, M6, W);

    for (i = 0; i < m; i++)
        for (j = 0; j < m; j++) {
            C[i + m][j] = X[i][j];
            C[i + m][j + m] = W[i][j];
        }
}

int main() {
    int A[MAX][MAX], B[MAX][MAX], C[MAX][MAX];
    int n, i, j;

    printf("Enter matrix size (power of 2, max 64): ");
    scanf("%d", &n);

    if (n < 1 || n > MAX || (n & (n - 1)) != 0) {
        printf("Invalid size! Enter 1, 2, 4, 8, 16, 32 or 64.\n");
        return 1;
    }

    printf("Enter elements of matrix A:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &A[i][j]);

    printf("Enter elements of matrix B:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &B[i][j]);

    multiply(n, A, B, C);

    printf("Resultant matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++)
            printf("%d ", C[i][j]);
        printf("\n");
    }

    return 0;
}
